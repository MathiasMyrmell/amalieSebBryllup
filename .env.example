# Kopier denne filen til .env.local og velg din egen kode.
# Det er koden du skriver inn på /admin for å se RSVP-svarene.
ADMIN_KODE=bytt-meg

# Hvor RSVP-svarene lagres.
#
# Lokalt: la denne stå tom. Da lagres svarene i data/rsvp.json, og du slipper
# å ha en database kjørende for å teste skjemaet.
#
# I drift (Vercel): settes automatisk når du kobler på en database fra
# Storage-fanen. Da brukes databasen i stedet, og tabellen lages av seg selv.
# POSTGRES_URL=postgres://bruker:passord@vert/database?sslmode=require
